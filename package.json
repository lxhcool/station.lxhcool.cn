{
  "name": "station-tab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"pnpm --filter server dev\" \"pnpm --filter client dev\"",
    "build": "pnpm --filter server build && pnpm --filter client build",
    "build:extension": "pnpm --filter client build:extension",
    "server": "pnpm --filter server dev",
    "client": "pnpm --filter client dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
